# ── Cloudflare R2 Object Storage (Set in Render Environment Variables) ──
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
# Alternatively provide Account ID:
# R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your_r2_bucket_name
# Optional: Public Domain / Dev URL (e.g., https://pub-xxxxxx.r2.dev or https://cdn.yourdomain.com)
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# ── Database ──
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:3306/<dbname>
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_password

# ── JWT & Auth ──
JWT_SECRET=your-super-secret-jwt-key
ALLOWED_ORIGINS=https://your-frontend-app.onrender.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GEMINI_API_KEY=your-gemini-api-key
